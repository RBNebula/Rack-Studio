# Cloudflare static asset headers (see docs/HOSTING.md). Not served as a file.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Robots-Tag: noindex, nofollow

# Vite fingerprints everything under /assets/, so those files never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The STEP import worker runs the bundled OpenCascade kernel (occt-import-js), whose Emscripten
# build compiles WebAssembly and evaluates generated code. A dedicated worker takes its policy
# from its own response, so only this same-origin worker script is exempt.
/assets/step.worker-*
  ! Content-Security-Policy
